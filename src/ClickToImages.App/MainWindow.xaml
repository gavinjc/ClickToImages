<Window
    x:Class="ClickToImages.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClickToImages.App"
    xmlns:vm="using:ClickToImages.App.ViewModels"
    xmlns:converters="using:ClickToImages.App.Converters"
    xmlns:about="using:Bureau.Common.About"
    xmlns:help="using:Bureau.Common.Help"
    xmlns:messages="using:Bureau.Common.Messages">

    <!-- PDFs dropped anywhere on the window are added, in the empty state too. -->
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource AppCanvasBackgroundBrush}"
        Loaded="RootGrid_Loaded"
        AllowDrop="True"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:PageCountConverter x:Key="PageCount"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar (app-conventions.md → Window layout): selection tools left; the checked-page
             count, the primary action, Help and About right. -->
        <Grid Grid.Row="0" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button
                    x:Uid="UndoButton"
                    Click="UndoButton_Click"
                    IsEnabled="{Binding CanEdit}"
                    Background="{ThemeResource AppToolbarButtonBackgroundBrush}"
                    BorderBrush="{ThemeResource AppToolbarButtonBorderBrush}"/>
                <DropDownButton
                    x:Uid="SelectPagesButton"
                    IsEnabled="{Binding CanEdit}"
                    Background="{ThemeResource AppToolbarButtonBackgroundBrush}"
                    BorderBrush="{ThemeResource AppToolbarButtonBorderBrush}">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem x:Uid="SelectAllItem" Click="SelectAll_Click"/>
                            <MenuFlyoutItem x:Uid="SelectNoneItem" Click="SelectNone_Click"/>
                            <MenuFlyoutItem x:Uid="InvertSelectionItem" Click="InvertSelection_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Uid="SelectOddItem" Click="SelectOdd_Click"/>
                            <MenuFlyoutItem x:Uid="SelectEvenItem" Click="SelectEven_Click"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <!-- Range entry (spec §4.3). An invalid range opens the attached flyout rather than
                     a line of text, so the toolbar never changes height. -->
                <TextBox
                    x:Name="PageRangeBox"
                    x:Uid="PageRangeBox"
                    Width="200"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding CanEdit}"
                    KeyDown="PageRangeBox_KeyDown">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout>
                            <TextBlock x:Uid="PageRangeInvalidText" TextWrapping="Wrap" MaxWidth="260"/>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </TextBox>
                <Button
                    x:Uid="ApplyRangeButton"
                    Click="ApplyRangeButton_Click"
                    IsEnabled="{Binding CanEdit}"
                    Background="{ThemeResource AppToolbarButtonBackgroundBrush}"
                    BorderBrush="{ThemeResource AppToolbarButtonBorderBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="CheckedPagesText" VerticalAlignment="Center"/>
                <!-- The only accent control in the toolbar. Enter anywhere runs it too. -->
                <Button
                    x:Name="SaveButton"
                    x:Uid="SaveButton"
                    IsEnabled="False"
                    Click="SaveButton_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
                <help:HelpButton Click="HelpButton_Click"/>
                <Button
                    x:Uid="AboutButton"
                    Style="{StaticResource IconButtonStyle}"
                    Click="AboutButton_Click">
                    <FontIcon Glyph="&#xE946;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Hand-rolled instead of Expander: Expander ignores the palette's theme-key overrides
             in this SDK build (lessons.md → WinUI controls and theming). Spec §4.3's options; each
             control's handler in code-behind writes MainWindow's ExportOptions record. -->
        <StackPanel Grid.Row="1" Margin="12,0,12,8">
            <Button
                x:Name="OptionsHeaderButton"
                x:Uid="OptionsHeaderButton"
                Click="OptionsHeaderButton_Click"
                Background="{ThemeResource AppPanelBackgroundBrush}"
                BorderBrush="{ThemeResource AppPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4,4,0,0"
                Padding="12,10"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="OptionsHeaderText" VerticalAlignment="Center"/>
                    <FontIcon x:Name="OptionsHeaderChevron" Grid.Column="1" Glyph="&#xE70D;" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
            </Button>
            <Border
                x:Name="OptionsBody"
                Background="{ThemeResource AppPanelBackgroundBrush}"
                BorderBrush="{ThemeResource AppPanelBorderBrush}"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,4,4"
                Visibility="Collapsed">
                <StackPanel Padding="12" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <!-- Items in each ComboBox carry their enum value's name as Tag. These controls'
                             handlers are attached in code-behind once the saved options are shown,
                             so nothing set while the XAML loads (a Slider coerces its Value to its
                             Minimum) overwrites them. -->
                        <ComboBox x:Name="ResolutionCombo" x:Uid="ResolutionCombo" MinWidth="200" IsEnabled="{Binding CanEdit}">
                            <ComboBoxItem x:Uid="ResolutionScreenItem" Tag="Screen"/>
                            <ComboBoxItem x:Uid="ResolutionGoodItem" Tag="Good"/>
                            <ComboBoxItem x:Uid="ResolutionPrintItem" Tag="Print"/>
                            <ComboBoxItem x:Uid="ResolutionMaximumItem" Tag="Maximum"/>
                        </ComboBox>
                        <ComboBox x:Name="FormatCombo" x:Uid="FormatCombo" MinWidth="120" IsEnabled="{Binding CanEdit}">
                            <ComboBoxItem x:Uid="FormatPngItem" Tag="Png"/>
                            <ComboBoxItem x:Uid="FormatJpegItem" Tag="Jpeg"/>
                            <ComboBoxItem x:Uid="FormatTiffItem" Tag="Tiff"/>
                        </ComboBox>
                        <Slider
                            x:Name="JpegQualitySlider"
                            x:Uid="JpegQualitySlider"
                            Width="180"
                            Minimum="1"
                            Maximum="100"
                            StepFrequency="1"/>
                        <!-- Greyed out for JPEG and TIFF, which have no transparency (spec §4.2). -->
                        <CheckBox
                            x:Name="TransparentCheckBox"
                            x:Uid="TransparentCheckBox"
                            VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox
                                    x:Name="OutputLocationCombo"
                                    x:Uid="OutputLocationCombo"
                                    MinWidth="240"
                                    IsEnabled="{Binding CanEdit}">
                                    <ComboBoxItem x:Uid="OutputSubfolderItem" Tag="SubfolderNamedAfterPdf"/>
                                    <ComboBoxItem x:Uid="OutputBesidePdfItem" Tag="BesidePdf"/>
                                    <ComboBoxItem x:Uid="OutputChosenFolderItem" Tag="ChosenFolder"/>
                                </ComboBox>
                                <Button
                                    x:Name="ChooseFolderButton"
                                    x:Uid="ChooseFolderButton"
                                    VerticalAlignment="Bottom"
                                    IsEnabled="{Binding CanEdit}"
                                    Click="ChooseFolderButton_Click"/>
                            </StackPanel>
                            <TextBlock
                                x:Name="ChosenFolderText"
                                FontSize="12"
                                MaxWidth="420"
                                HorizontalAlignment="Left"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBox
                                x:Name="NamingPatternBox"
                                x:Uid="NamingPatternBox"
                                Width="280"
                                IsEnabled="{Binding CanEdit}"/>
                            <!-- The live example (spec §4.3), or what is wrong with the pattern. -->
                            <TextBlock
                                x:Name="NamingExampleText"
                                FontSize="12"
                                MaxWidth="420"
                                TextWrapping="Wrap"
                                HorizontalAlignment="Left"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock
                                x:Name="NamingProblemText"
                                FontSize="12"
                                MaxWidth="420"
                                TextWrapping="Wrap"
                                HorizontalAlignment="Left"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Visibility="Collapsed"/>
                            <TextBlock x:Uid="NamingTokensText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Progress row (app-conventions.md → Window layout), collapsed when idle. -->
        <StackPanel
            x:Name="ExportProgressPanel"
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="12"
            Padding="12,0,12,8"
            Visibility="Collapsed">
            <ProgressBar x:Name="ExportProgressBar" Width="300" Minimum="0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ExportProgressText" VerticalAlignment="Center"/>
            <Button x:Name="CancelExportButton" x:Uid="CancelExportButton" Click="CancelExportButton_Click"/>
        </StackPanel>

        <!-- Once anything is loaded: the PDF list left and the page grid right, as in ClickTo:
             Speech (app-conventions.md → Window layout). The empty state and the message bar span
             both columns. -->
        <Grid Grid.Row="3" Padding="12,0,12,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="&#xE8A5;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Uid="EmptyStateText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                <Button
                    x:Name="ChoosePdfsButton"
                    x:Uid="ChoosePdfsButton"
                    Click="ChoosePdfsButton_Click"
                    IsEnabled="{Binding CanEdit}"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"/>
            </StackPanel>

            <Grid
                Grid.Column="0"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="PdfsHeaderLabel" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    <Rectangle Grid.Column="1" Height="1" Fill="{ThemeResource AppPanelBorderBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Dragging a row reorders the PDFs; the grid's sections and the " (2)" naming
                     follow. ListView moves the items itself, and DragItemsCompleted records the
                     move for undo. Choosing a row, by click, keyboard or screen reader, jumps the
                     grid to that PDF's section; ItemClick covers clicking the row already chosen.
                     Single selection only: nothing in Images acts on several PDFs at once. While a
                     save runs, CanEdit turns dragging and every editing control off; inside item
                     templates it is reached through RootGrid's DataContext, since the template's
                     own is the item. -->
                <ListView
                    x:Name="DocumentsList"
                    Grid.Row="1"
                    Padding="0,0,0,72"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    CanReorderItems="{Binding CanEdit}"
                    CanDragItems="{Binding CanEdit}"
                    AllowDrop="True"
                    ItemClick="DocumentsList_ItemClick"
                    SelectionChanged="DocumentsList_SelectionChanged"
                    DragItemsStarting="DocumentsList_DragItemsStarting"
                    DragItemsCompleted="DocumentsList_DragItemsCompleted">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentGroup">
                            <Grid AutomationProperties.Name="{x:Bind FileName}">
                                <Border
                                    Background="{ThemeResource AppTileBackgroundBrush}"
                                    BorderBrush="{ThemeResource AppTileBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE76F;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock
                                                Text="{x:Bind local:MainWindow.DocumentDetailText(PageCount, CheckedPageCount, HasFailed), Mode=OneWay}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button
                                            x:Uid="RemoveDocumentButton"
                                            Grid.Column="2"
                                            Tag="{x:Bind}"
                                            Click="RemoveDocumentButton_Click"
                                            IsEnabled="{Binding DataContext.CanEdit, ElementName=RootGrid}"
                                            Style="{StaticResource IconButtonStyle}"
                                            VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <!-- Selection highlight, as on the page tiles. -->
                                <Border
                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.12"
                                    CornerRadius="6"
                                    IsHitTestVisible="False"/>
                                <Border
                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    IsHitTestVisible="False"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Adds more PDFs, never replacing them. Rests at the bottom-right of the list (the
                     list's bottom padding keeps its last row clear of it) and rises above the
                     message bar whenever a message would cover it. -->
                <messages:AddButton
                    x:Uid="AddPdfsButton"
                    Grid.Row="1"
                    KeepAbove="{x:Bind Messages}"
                    Click="ChoosePdfsButton_Click"
                    IsEnabled="{Binding CanEdit}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,12,8"/>
            </Grid>

            <!-- Grouped by source document (spec §4.3), in the list's order; ItemsSource is a
                 grouped CollectionViewSource set in code-behind. No drag-reorder of pages: page
                 order is the document's (spec §0.4). GridView selection is only what R / Shift+R
                 act on; the tile checkboxes say what gets exported. -->
            <GridView
                x:Name="PagesGridView"
                Grid.Column="1"
                Padding="0,0,0,8"
                SelectionMode="Extended"
                IsItemClickEnabled="False"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                SelectionChanged="PagesGridView_SelectionChanged">
                <GridView.Resources>
                    <!-- Ported from ClickTo: Slideshow. GridViewItem's default template paints
                         PointerOver/Pressed/Selected chrome above the item's content, washing out the
                         tile's buttons on hover, so it is replaced by a plain ContentPresenter. The
                         DataTemplate draws the selection highlight from PageItem.IsSelected, and the
                         FocusStates group restores the keyboard focus rect the swap removed. -->
                    <Style x:Key="TileContainerStyle" TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewItem">
                                    <Grid>
                                        <ContentPresenter
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                        <Border
                                            x:Name="FocusVisual"
                                            BorderBrush="{ThemeResource SystemControlFocusVisualPrimaryBrush}"
                                            BorderThickness="2"
                                            CornerRadius="4"
                                            IsHitTestVisible="False"
                                            Opacity="0"/>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="FocusStates">
                                                <VisualState x:Name="Focused">
                                                    <VisualState.Setters>
                                                        <Setter Target="FocusVisual.Opacity" Value="1"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Unfocused"/>
                                                <VisualState x:Name="PointerFocused"/>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GridView.Resources>
                <GridView.ItemContainerStyle>
                    <StaticResource ResourceKey="TileContainerStyle"/>
                </GridView.ItemContainerStyle>

                <!-- Section header style (app-conventions.md): SemiBold secondary text, then a
                     1 px rule filling the rest of the line. -->
                <GridView.GroupStyle>
                    <GroupStyle HidesIfEmpty="False">
                        <!-- A plain presenter: the default GridViewHeaderItem template draws a
                             divider of its own under the header, doubling the rule. -->
                        <GroupStyle.HeaderContainerStyle>
                            <Style TargetType="GridViewHeaderItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewHeaderItem">
                                            <ContentPresenter
                                                Margin="4,16,4,8"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.HeaderContainerStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="vm:DocumentGroup">
                                <StackPanel Spacing="2">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="{x:Bind FileName}"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center"/>
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding PageCount, Converter={StaticResource PageCount}}"
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center"/>
                                        <Rectangle Grid.Column="2" Height="1" Fill="{ThemeResource AppPanelBorderBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock x:Uid="DocumentOpenFailedText" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                        <TextBlock Text="{x:Bind ErrorMessage}" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </GridView.GroupStyle>

                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageItem">
                        <Grid
                            Tag="{x:Bind}"
                            Width="172"
                            Height="236"
                            Margin="4"
                            DoubleTapped="Tile_DoubleTapped"
                            PointerEntered="Tile_PointerEntered"
                            PointerExited="Tile_PointerExited">

                            <Border
                                Background="{ThemeResource AppTileBackgroundBrush}"
                                BorderBrush="{ThemeResource AppTileBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Padding="6">
                                        <!-- Sized from PageItem.ThumbnailArea, which ThumbnailScale and
                                             the thumbnails' render size are computed from too. -->
                                        <Image
                                            Width="{x:Bind vm:PageItem.ThumbnailArea.Width}"
                                            Height="{x:Bind vm:PageItem.ThumbnailArea.Height}"
                                            Source="{x:Bind Thumbnail, Mode=OneWay}"
                                            Stretch="Uniform"
                                            RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <CompositeTransform
                                                    Rotation="{x:Bind RotationDegrees, Mode=OneWay}"
                                                    ScaleX="{x:Bind ThumbnailScale, Mode=OneWay}"
                                                    ScaleY="{x:Bind ThumbnailScale, Mode=OneWay}"/>
                                            </Image.RenderTransform>
                                        </Image>

                                        <!-- Unchecked pages fade back so the selection reads at a glance. -->
                                        <Border
                                            Background="{ThemeResource AppTileBackgroundBrush}"
                                            Opacity="0.6"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                                        <!-- Plain text, not ProgressRing: ProgressRing.IsActive crashes
                                             natively inside a virtualized GridView item template
                                             (lessons.md). -->
                                        <TextBlock
                                            x:Uid="LoadingText"
                                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <StackPanel
                                            Spacing="4"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{Binding ErrorDetail}"
                                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                                            <FontIcon Glyph="&#xE783;" FontSize="24" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                            <TextBlock x:Uid="CantLoadText" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- OneWay plus a Click handler rather than TwoWay, so every
                                             toggle goes through the view model and can be undone. -->
                                        <Border
                                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                            CornerRadius="4"
                                            Padding="4,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <CheckBox
                                                x:Uid="PageCheckBox"
                                                MinWidth="0"
                                                Padding="0"
                                                Tag="{x:Bind}"
                                                IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                                IsEnabled="{Binding DataContext.CanEdit, ElementName=RootGrid}"
                                                Click="PageCheckBox_Click"/>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1" Padding="4,2,4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="10" Padding="8,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind PageNumber}"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                FontSize="12"/>
                                        </Border>

                                        <!-- One pill for the tile's buttons, as in both siblings;
                                             Tile_PointerEntered/Exited raise its Opacity on hover. -->
                                        <Border
                                            x:Name="ChromePill"
                                            Grid.Column="1"
                                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                            CornerRadius="12"
                                            Padding="2"
                                            Opacity="0.55">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Uid="CopyPageButton" Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}" Click="CopyPageButton_Click">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </Button>
                                                <Button x:Uid="PreviewPageButton" Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}" Click="PreviewButton_Click">
                                                    <FontIcon Glyph="&#xE71E;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </Button>
                                                <Button x:Uid="TileRotateLeftButton" Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}" IsEnabled="{Binding DataContext.CanEdit, ElementName=RootGrid}" Click="RotateLeftButton_Click">
                                                    <FontIcon Glyph="&#xE7AD;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" RenderTransformOrigin="0.5,0.5">
                                                        <FontIcon.RenderTransform>
                                                            <ScaleTransform ScaleX="-1"/>
                                                        </FontIcon.RenderTransform>
                                                    </FontIcon>
                                                </Button>
                                                <Button x:Uid="TileRotateRightButton" Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}" IsEnabled="{Binding DataContext.CanEdit, ElementName=RootGrid}" Click="RotateRightButton_Click">
                                                    <FontIcon Glyph="&#xE7AD;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border
                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Opacity="0.12"
                                CornerRadius="4"
                                IsHitTestVisible="False"/>
                            <Border
                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="2"
                                CornerRadius="4"
                                IsHitTestVisible="False"/>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Floating, not row-based: an Auto row here would shift the page grid when a message
                 appears, and the user is looking at the grid when that happens. The grid's own
                 12 px padding gives it the usual 12 px from the window's sides. -->
            <messages:MessageBar x:Name="Messages" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="0,8"/>
        </Grid>

        <!-- Per-tile preview (spec §4.3), rendered to fit the window. The overlay's background
             closes it on a click; its controls stop that Tapped from bubbling up to it. -->
        <Grid
            x:Name="PreviewOverlay"
            Grid.RowSpan="4"
            Background="#CC000000"
            Visibility="Collapsed"
            Tapped="PreviewOverlay_Tapped">
            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="40,56" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="PreviewImageTransform"/>
                </Image.RenderTransform>
            </Image>

            <Button
                x:Uid="PreviewCloseButton"
                Style="{StaticResource IconButtonStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                Click="PreviewCloseButton_Click"
                Tapped="StopTappedPropagation">
                <FontIcon Glyph="&#xE711;" FontSize="18" Foreground="White"/>
            </Button>

            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,16">
                <Button
                    x:Uid="PreviewRotateLeftButton"
                    Style="{StaticResource IconButtonStyle}"
                    Click="PreviewRotateLeftButton_Click"
                    IsEnabled="{Binding CanEdit}"
                    Tapped="StopTappedPropagation">
                    <FontIcon Glyph="&#xE7AD;" FontSize="18" Foreground="White" RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <ScaleTransform ScaleX="-1"/>
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Button>
                <Button
                    x:Uid="PreviewRotateRightButton"
                    Style="{StaticResource IconButtonStyle}"
                    Click="PreviewRotateRightButton_Click"
                    IsEnabled="{Binding CanEdit}"
                    Tapped="StopTappedPropagation">
                    <FontIcon Glyph="&#xE7AD;" FontSize="18" Foreground="White"/>
                </Button>
            </StackPanel>

            <TextBlock
                x:Name="PreviewIndicatorText"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Foreground="White" FontSize="14"/>

            <CheckBox
                x:Name="PreviewCheckBox"
                x:Uid="PreviewCheckBox"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,16"
                Foreground="White"
                IsEnabled="{Binding CanEdit}"
                Click="PreviewCheckBox_Click"
                Tapped="StopTappedPropagation"/>
        </Grid>

        <ContentDialog x:Name="ReplaceFilesDialog" x:Uid="ReplaceFilesDialog" DefaultButton="Primary"/>

        <ContentDialog x:Name="CloseConfirmDialog" x:Uid="CloseConfirmDialog" DefaultButton="Primary"/>

        <!-- One prompt per password-protected PDF (spec §4.2, M4). -->
        <ContentDialog x:Name="PasswordDialog" x:Uid="PasswordDialog" DefaultButton="Primary">
            <StackPanel Spacing="12" MaxWidth="400">
                <TextBlock x:Name="PasswordPromptText" TextWrapping="Wrap"/>
                <PasswordBox x:Name="PasswordInput" x:Uid="PasswordInput"/>
            </StackPanel>
        </ContentDialog>

        <!-- Shared Bureau.Common dialog: version, cross-promotion and diagnostics come from there;
             ProductName, Description and LogDirectoryPath are set in code-behind. -->
        <about:AboutDialog x:Name="AboutDialog">
            <!-- MIT requires the copyright/permission notice be included with distributed copies of
                 the software. Both packages this build ships are MIT: WIL, compiled into the shell
                 extension, and CommunityToolkit.Mvvm in the app. Bureau.Common brings nothing
                 beyond the Windows App SDK. Add a line here in the same commit as every new
                 package. -->
            <about:AboutDialog.ThirdPartyNotices>
                <StackPanel Spacing="12">
                    <TextBlock TextWrapping="Wrap" FontSize="12">
                        CommunityToolkit.Mvvm — Copyright © .NET Foundation and Contributors
                        <LineBreak/>
