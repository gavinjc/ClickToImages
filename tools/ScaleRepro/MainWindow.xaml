<Window
    x:Class="ScaleRepro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The controls Gavin saw garble: buttons, a text box, a header line, a check box and a combo
         box, plus a bitmap-free rectangle as the "plain background" that stayed right. RootGrid has
         no Background by default so a backdrop shows through; "palette" paints it as the apps do. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Shown and handed to SetTitleBar only with "customtitle". -->
        <Grid x:Name="CustomTitleBar" Height="32" Padding="12,0" Visibility="Collapsed">
            <TextBlock x:Name="CustomTitleText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <StackPanel Grid.Row="1" Padding="24" Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock x:Name="HeaderText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
            <TextBlock x:Name="ScaleText" Style="{StaticResource CaptionTextBlockStyle}"/>
            <TextBlock Text="The quick brown fox jumps over the lazy dog 0123456789" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Export"/>
                <Button Content="Copy to clipboard"/>
                <Button>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7AD;" FontSize="14"/>
                        <TextBlock Text="Rotate"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}" Content="Save"/>
            </StackPanel>

            <TextBox Header="Pages" Text="1-3, 5, 7..12" Width="240" HorizontalAlignment="Left"/>
            <CheckBox Content="Transparent background" IsChecked="True"/>
            <ComboBox Header="Format" SelectedIndex="0" Width="240">
                <x:String>PNG</x:String>
                <x:String>JPEG</x:String>
                <x:String>TIFF</x:String>
            </ComboBox>

            <Rectangle Height="40" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
        </StackPanel>

        <!-- Filled in code for "addbutton" and "messagebar", which need Bureau.Common types. -->
        <Grid x:Name="ChromeHost" Grid.Row="1"/>
    </Grid>
</Window>
